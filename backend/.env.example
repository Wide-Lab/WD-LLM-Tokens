# Config do backend quando ele roda fora do compose (uvicorn direto).
# No compose, quem manda as variáveis é o `.env` da raiz.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tokens
LOG_LEVEL=INFO

# Origens de clientes externos. Vazio basta atrás do nginx e também no `vite dev`, que faz
# proxy de `/api` para cá — nos dois casos o painel chama a API na própria origem.
CORS_ORIGINS=[]

# Assina o cookie de sessão do painel. Vazio = login indisponível (503). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_SESSAO=troque-por-um-valor-aleatorio-longo
SESSAO_DURACAO_HORAS=168

# `false` no dev local, que roda em HTTP puro; `true` em produção com TLS.
COOKIE_SEGURO=false

# A chave que cadastra preço e usuário — as duas portas sem tela, e a única chave em variável de
# ambiente. As de escrita e leitura nascem em `POST /v1/chaves` e ficam no banco; `CHAVES_ESCRITA`
# e `CHAVE_LEITURA` não são mais lidas daqui.
CHAVE_ADMIN=troque-esta-chave-de-admin
