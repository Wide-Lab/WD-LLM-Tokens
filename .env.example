# Porta pública do nginx de borda (único ponto de entrada).
PORT=8107

# Postgres (db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tokens

# Backend
LOG_LEVEL=INFO

# Atrás do nginx, painel e API compartilham a mesma origem — CORS fica vazio, que é o normal.
# Só preencha se algum cliente de outra origem for consumir a API.
CORS_ORIGINS=[]

# Assina o cookie de sessão do painel. Vazio = login indisponível (503). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar este valor derruba todas as sessões em aberto.
SEGREDO_SESSAO=troque-por-um-valor-aleatorio-longo

# Validade da sessão. 168h = 7 dias.
SESSAO_DURACAO_HORAS=168

# `Secure` no cookie: só viaja em HTTPS. Deixe `true` em produção. `localhost` funciona mesmo
# em HTTP (exceção do browser); acessar por IP de rede sem TLS, não — só aí vale `false`.
COOKIE_SEGURO=true

# A chave que cadastra preço (`POST /v1/precos`) e usuário (`POST /v1/usuarios`) — as duas
# portas que não têm tela. É por ela que nasce o primeiro login; ver o README.
#
# É a única chave que mora aqui. As de escrita (uma por aplicação) e a de leitura nascem em
# `POST /v1/chaves`, com esta, e ficam no banco: variável de ambiente para elas o backend não lê
# mais. Pôr `CHAVES_ESCRITA` ou `CHAVE_LEITURA` neste arquivo não dá erro e não abre nada.
CHAVE_ADMIN=troque-esta-chave-de-admin
